# Параметры AIS-catcher. Ставится в /etc/default/ais-catcher один раз, дальше правится руками.
# Поправка частоты донгла +31 ppm (измерил сам AIS-catcher на Mac); без неё сообщений в 8 раз меньше.
RECEIVER_OPTIONS="-d:0 -p 31 -gr RTLAGC on TUNER auto"
# координаты дома (здесь — пример, центр Лимассола; поставить свои, как в /etc/nebo/config.toml); -v 60 — раз в минуту статистика в журнал
STATION_OPTIONS="-Z 34.68 33.04 -v 60"
# встроенный веб-сервер (его карта и /api/ships.json) только для своих: nebo проксирует его на :8080/ships
WEB_OPTIONS="-N 8100 IP_BIND 127.0.0.1"
